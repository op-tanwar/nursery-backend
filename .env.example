# ======================================================================
# 🚀 CORE SERVER CONFIGURATION
# ======================================================================
PORT=4000
NODE_ENV=development

# ======================================================================
# 🗄️ DATABASE CONNECTION
# ======================================================================
# MongoDB Connection String (e.g., mongodb://localhost:27017/planto_db or mongodb+srv://<user>:<password>@cluster.mongodb.net/planto_db)
DB_URI=mongodb://localhost:27017/planto_db

# ======================================================================
# 🔑 SECURITY & JWT AUTHENTICATION
# ======================================================================
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_TIME=7d
COOKIE_EXPIRES_TIME=7

# ======================================================================
# 🔑 OAUTH 2.0 AUTHENTICATION (GOOGLE)
# ======================================================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ======================================================================
# 🌐 CORS & APPLICATION ORIGINS
# ======================================================================
FRONTEND_URL=https://urbannursery.in

# ======================================================================
# ☁️ CLOUDINARY MEDIA ASSETS STORAGE
# ======================================================================
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ======================================================================
# 💳 PAYMENT GATEWAY INTEGRATION (RAZORPAY)
# ======================================================================
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ======================================================================
# 📧 PRIMARY TRANSACTIONAL EMAIL ENGINE (SMTP)
# ======================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password
EMAIL_FROM_NAME=Urban Nursery Support

# ======================================================================
# 🛡️ ADMINISTRATIVE SETTINGS
# ======================================================================
ADMIN_EMAIL=admin@example.com

# ======================================================================
# 📍 NURSERY SERVICE COVERAGE
# ======================================================================
# Geographic radius (km) used for local nursery service coverage
NURSERY_SERVICE_RADIUS_KM=12
