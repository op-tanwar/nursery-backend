# ======================================================================
# 🚀 CORE SERVER CONFIGURATION
# ======================================================================
PORT=4000
NODE_ENV=development

# ======================================================================
# 🗄️ DATABASE CONNECTION
# ======================================================================
# MongoDB Connection String (e.g., mongodb://localhost:27017/planto_db or mongodb+srv://<user>:<password>@cluster.mongodb.net/planto_db)
DB_URI=mongodb://localhost:27017/planto_db

# ======================================================================
# 🔑 SECURITY & JWT AUTHENTICATION
# ======================================================================
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_TIME=7d
COOKIE_EXPIRES_TIME=7

# ======================================================================
# 🔑 OAUTH 2.0 AUTHENTICATION (GOOGLE)
# ======================================================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ======================================================================
# 🌐 CORS & APPLICATION ORIGINS
# ======================================================================
# Comma-separated list of allowed frontend origins (Vercel previews and localhost ports are auto-whitelisted)
FRONTEND_URL=https://urbannursery.in,https://urbannursery-neon.vercel.app

# ======================================================================
# ☁️ CLOUDINARY MEDIA ASSETS STORAGE
# ======================================================================
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ======================================================================
# 💳 PAYMENT GATEWAY INTEGRATION (RAZORPAY)
# ======================================================================
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ======================================================================
# 📧 PRIMARY TRANSACTIONAL EMAIL ENGINE (SMTP)
# ======================================================================
# Standard SMTP conventions (preferred for Render / AWS / Cloud platforms)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_SERVICE=gmail
SMTP_MAIL=your_email@gmail.com
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
SMTP_PASS=your_16_char_google_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Urban Nursery Support

# Alternative EMAIL_* conventions
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_16_char_google_app_password
EMAIL_FROM_NAME=Urban Nursery Support
APP_NAME=Urban Nursery
FROM_EMAIL=your_email@gmail.com

# ======================================================================
# 🛡️ ADMINISTRATIVE SETTINGS
# ======================================================================
ADMIN_EMAIL=admin@example.com
ADMIN_ALERT_EMAIL=admin@example.com
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# ======================================================================
# 📍 NURSERY SERVICE COVERAGE
# ======================================================================
# Geographic radius (km) used for local nursery service coverage
NURSERY_SERVICE_RADIUS_KM=12

# ======================================================================
# 🔴 DISTRIBUTED CACHE & LOCKING (REDIS / IOREDIS)
# ======================================================================
# Standard Redis connection URI without CLI wrappers (never include redis-cli, --tls, or -u):
# Upstash / TLS: rediss://default:your_upstash_password@cluster-endpoint.upstash.io:6379
# Local / Non-TLS: redis://127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379
# Alternatively, individual connection parameters:
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_DB=0
REDIS_TLS=false
